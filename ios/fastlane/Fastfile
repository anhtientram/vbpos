# frozen_string_literal: true

default_platform(:ios)

platform :ios do
  desc "Upload dev IPA to TestFlight (App Store Connect API Key + match)"
  lane :beta do
    setup_ci if ENV["CI"] == "true"

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    match(
      type: "appstore",
      app_identifier: "com.biexce.vbpos.app",
      readonly: true,
      git_basic_authorization: Base64.strict_encode64(
        "#{ENV.fetch('MATCH_GIT_BASIC_AUTHORIZATION_USER')}:#{ENV.fetch('MATCH_GIT_BASIC_AUTHORIZATION_PASSWORD')}"
      )
    )

    ipa_path = ENV.fetch("IPA_PATH") do
      Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)].first
    end

    UI.user_error!("IPA not found. Set IPA_PATH or build with flutter build ipa first.") if ipa_path.nil? || !File.exist?(ipa_path)

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      app_identifier: "com.biexce.vbpos.app",
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
